@page
@model Licensing.Portal.Pages.Admin.GenerateECDSAKeysModel
@{
    ViewData["Title"] = "Generate ECDSA Keys";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f5f5f5;
        padding: 20px;
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
    }

    .header {
        background: white;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .header h1 {
        color: #333;
        font-size: 28px;
    }

    .card {
        background: white;
        padding: 30px;
        border-radius: 5px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .info-box {
        background: #e3f2fd;
        border-left: 4px solid #2196f3;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 5px;
    }

    .info-box h3 {
        color: #1976d2;
        margin-bottom: 10px;
    }

    .success-message {
        background-color: #d4edda;
        color: #155724;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border-left: 4px solid #28a745;
    }

    .error-message {
        background-color: #fee;
        color: #c33;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border-left: 4px solid #c33;
    }

    .warning-box {
        background: #fff3cd;
        border-left: 4px solid #ff9800;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 5px;
    }

    .warning-box h3 {
        color: #ff6f00;
        margin-bottom: 10px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-weight: 600;
    }

    textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 13px;
        font-family: 'Courier New', monospace;
        resize: vertical;
        box-sizing: border-box;
    }

    textarea:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 5px rgba(102, 126, 234, 0.1);
    }

    .button-group {
        display: flex;
        gap: 10px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 20px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        flex: 1;
        min-width: 150px;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
        flex: 1;
        min-width: 150px;
    }

    .btn-secondary:hover {
        background: #5a6268;
    }

    .btn-success {
        background: #28a745;
        color: white;
        flex: 1;
        min-width: 150px;
    }

    .btn-success:hover {
        background: #218838;
        transform: translateY(-2px);
    }

    .btn-link {
        background: none;
        border: none;
        color: #667eea;
        cursor: pointer;
        text-decoration: underline;
        padding: 0;
        font-size: 14px;
    }

    .btn-link:hover {
        color: #764ba2;
    }

    .key-display {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        padding: 15px;
        border-radius: 5px;
        margin-top: 10px;
        max-height: 200px;
        overflow-y: auto;
        word-break: break-all;
        font-family: 'Courier New', monospace;
        font-size: 12px;
        color: #333;
    }

    .status-badge {
        display: inline-block;
        padding: 8px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .status-badge.active {
        background: #d4edda;
        color: #155724;
    }

    .status-badge.pending {
        background: #fff3cd;
        color: #856404;
    }

    .section {
        margin-bottom: 30px;
    }

    .section-title {
        color: #333;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 15px;
        border-bottom: 2px solid #667eea;
        padding-bottom: 10px;
    }

    .copy-button {
        background: #667eea;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        margin-top: 10px;
    }

    .copy-button:hover {
        background: #764ba2;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }
</style>

<style media="(max-width: 768px)">
    .grid-2 {
        grid-template-columns: 1fr;
    }

    .button-group {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }
</style>

<div class="header">
    <h1>ECDSA Key Management</h1>
</div>

<div class="container">
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="success-message">
            <strong>Success:</strong> @Model.Message
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-message">
            <strong>Error:</strong> @Model.ErrorMessage
        </div>
    }

    <div class="card">
        <div class="info-box">
            <h3>About ECDSA Keys</h3>
            <p>ECDSA (Elliptic Curve Digital Signature Algorithm) uses a pair of cryptographic keys:</p>
            <ul style="margin-left: 20px; margin-top: 10px;">
                <li><strong>Private Key:</strong> Used to sign/generate licenses. Keep this secret and secure.</li>
                <li><strong>Public Key:</strong> Used to verify license signatures. Can be distributed.</li>
            </ul>
        </div>

        @if (Model.KeysStored)
        {
            <div class="status-badge active">? Keys Stored</div>
        }

        <div class="section">
            <div class="section-title">Generate New Keys</div>
            <p style="color: #666; margin-bottom: 15px;">Click the button below to generate a new ECDSA key pair. The keys will be displayed but not yet stored.</p>

            <form method="post" asp-page-handler="Generate">
                <button type="submit" class="btn btn-primary">Generate New ECDSA Key Pair</button>
            </form>
        </div>

        @if (Model.KeysGenerated || Model.KeysStored)
        {
            <div class="section">
                <div class="section-title">Key Display</div>

                @if (!Model.KeysStored)
                {
                    <div class="warning-box">
                        <h3>? Keys Not Yet Stored</h3>
                        <p>The keys below are generated but not yet saved. Click "Store Keys" to save them to Azure Table Storage.</p>
                    </div>
                }

                <form method="post">
                    <div class="form-group">
                        <label for="privateKey">Private Key (Keep Secure!)</label>
                        <textarea id="privateKey" name="PrivateKey" rows="6" readonly asp-for="PrivateKey"></textarea>
                        <button type="button" class="copy-button" onclick="copyToClipboard('privateKey')">Copy to Clipboard</button>
                    </div>

                    <div class="form-group">
                        <label for="publicKey">Public Key (For Verification)</label>
                        <textarea id="publicKey" name="PublicKey" rows="6" readonly asp-for="PublicKey"></textarea>
                        <button type="button" class="copy-button" onclick="copyToClipboard('publicKey')">Copy to Clipboard</button>
                    </div>

                    @if (Model.KeysGenerated && !Model.KeysStored)
                    {
                        <div class="button-group">
                            <button type="submit" asp-page-handler="Store" class="btn btn-success">Store Keys</button>
                            <button type="button" onclick="window.location.reload()" class="btn btn-secondary">Generate New</button>
                        </div>
                    }
                </form>
            </div>
        }
    </div>

    <div class="card">
        <div class="section-title">Configuration</div>
        <p style="color: #666; margin-bottom: 10px;"><strong>Current Setting:</strong></p>
        <div class="key-display">
            Licensing:SignatureAlgorithm = ECDSA (from appsettings.json)
        </div>
        <p style="color: #666; margin-top: 15px; font-size: 12px;">
            The signature algorithm is configured in <code>appsettings.json</code>. Change the value to "HMAC" to switch back to HMAC-based signing.
        </p>
    </div>

    <div style="margin-bottom: 30px;">
        <button onclick="window.location.href='/Dealers/Index'" class="btn btn-secondary">Back to Admin Panel</button>
    </div>
</div>

<script>
    function copyToClipboard(elementId) {
        const element = document.getElementById(elementId);
        const text = element.value;
        
        navigator.clipboard.writeText(text).then(() => {
            alert('Copied to clipboard!');
        }).catch(err => {
            console.error('Failed to copy:', err);
            alert('Failed to copy to clipboard');
        });
    }
</script>
